{
  "name": "Taxi Flutter Lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8080, 8081, 8082],
  "portsAttributes": {
    "8080": {"label": "Taxi Customers"},
    "8081": {"label": "Taxi API"},
    "8082": {"label": "Taxi Driver"}
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/flutter/bin"
  },
  "remoteUser": "vscode"
}
